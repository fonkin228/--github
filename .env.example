# --- Telegram -------------------------------------------------------------
# Токен от @BotFather. Без него Mini App работает, но бот и отправка файла в чат — нет.
BOT_TOKEN=

# Публичный https-URL, на котором открывается Mini App.
# Его же вписываете в BotFather: /newapp или /setmenubutton.
WEBAPP_URL=https://example.com

# Публичный адрес сервера для вебхука. Обычно совпадает с WEBAPP_URL.
PUBLIC_URL=

# Прямая ссылка на Mini App: https://t.me/имя_бота/короткое_имя_приложения.
# Нужна для групп — там инлайн-кнопки web_app не работают, а ссылка работает.
MINIAPP_LINK=

# polling — локальная разработка; webhook — прод; off — выключить бота.
BOT_MODE=polling
# Случайная строка, из неё собирается путь вебхука /telegram/<secret>
WEBHOOK_SECRET=

# --- Сервер ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_PATH=./data/app.db

# --- Доступ ---------------------------------------------------------------
# К общей базе пускаются участники групп, куда добавлен бот.
# Список групп ведётся сам: добавили бота в группу — её участники получили доступ.

# Telegram ID владельца: доступ есть всегда, даже вне групп.
OWNER_ID=
# Дополнительные ID через запятую, помимо участников групп.
ALLOWED_USERS=

# --- Безопасность ---------------------------------------------------------
# true = можно открывать Mini App в обычном браузере без подписи Telegram.
# В проде ОБЯЗАТЕЛЬНО false.
ALLOW_DEV_AUTH=true
# Максимальный возраст initData, сек.
INIT_DATA_MAX_AGE=86400
# Предохранитель на размер пакета сумм.
MAX_ROWS=1000
